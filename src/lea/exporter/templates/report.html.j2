<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ report_title }} - {{ input_paper.title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #0b0f19;
            --bg-card: rgba(30, 41, 59, 0.7);
            --bg-card-hover: rgba(51, 65, 85, 0.8);
            --accent-glow: rgba(59, 130, 246, 0.15);
            --border-color: rgba(255, 255, 255, 0.1);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --primary: #3b82f6;
            --secondary: #8b5cf6;
            --success: #10b981;
            --warning: #f59e0b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-main);
            line-height: 1.6;
            padding: 2rem 1rem;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95));
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 2.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 8px 32px 0 var(--accent-glow);
        }

        h1 {
            font-size: 2.2rem;
            font-weight: 700;
            background: linear-gradient(90deg, #60a5fa, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.75rem;
        }

        .meta-strip {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 1rem;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .badge {
            background: rgba(59, 130, 246, 0.15);
            color: #93c5fd;
            border: 1px solid rgba(59, 130, 246, 0.3);
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.8rem;
            font-weight: 500;
        }

        .badge-success, .badge-public {
            background: rgba(16, 185, 129, 0.15);
            color: #6ee7b7;
            border-color: rgba(16, 185, 129, 0.3);
        }

        .badge-warning, .badge-restricted {
            background: rgba(245, 158, 11, 0.15);
            color: #fcd34d;
            border-color: rgba(245, 158, 11, 0.3);
        }

        .badge-proprietary {
            background: rgba(139, 92, 246, 0.15);
            color: #c084fc;
            border-color: rgba(139, 92, 246, 0.3);
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 2rem 0 1rem 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .card {
            background: var(--bg-card);
            backdrop-filter: blur(8px);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.75rem;
            margin-bottom: 1.5rem;
            transition: all 0.2s ease-in-out;
        }

        .card:hover {
            background: var(--bg-card-hover);
            border-color: rgba(255, 255, 255, 0.2);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .paper-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #ffffff;
            text-decoration: none;
        }

        .paper-authors {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        .summary-box {
            background: rgba(15, 23, 42, 0.6);
            border-left: 4px solid var(--primary);
            border-radius: 4px;
            padding: 1.25rem;
            margin: 1rem 0;
        }

        .summary-field {
            margin-bottom: 0.75rem;
        }

        .summary-field label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #93c5fd;
            font-weight: 600;
            display: block;
            margin-bottom: 0.25rem;
        }

        .paragraph-summary {
            font-size: 0.95rem;
            line-height: 1.7;
            color: #e2e8f0;
        }

        pre.bibtex {
            background: #090d16;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1rem;
            font-family: 'Fira Code', monospace;
            font-size: 0.85rem;
            color: #a7f3d0;
            overflow-x: auto;
            margin-top: 1rem;
        }

        .actions {
            display: flex;
            gap: 0.75rem;
            margin-top: 1rem;
        }

        .btn {
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            padding: 0.4rem 0.9rem;
            border-radius: 6px;
            font-size: 0.85rem;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: background 0.2s;
        }

        .btn:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background: #2563eb;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <span class="badge">Literature Exploration Agent</span>
            <h1>{{ report_title }}</h1>
            <p style="font-size: 1.1rem; color: #cbd5e1;">Target Input Paper: <strong>{{ input_paper.title }}</strong></p>

            <div class="meta-strip">
                <div><strong>DOI:</strong> {{ input_paper.doi or 'N/A' }}</div>
                <div><strong>arXiv:</strong> {{ input_paper.arxiv_id or 'N/A' }}</div>
                <div><strong>Year:</strong> {{ input_paper.publication_year or 'N/A' }}</div>
                <div><span class="badge badge-success">Exclusion Status: {{ exclusion_status }}</span></div>
            </div>
        </header>

        <h2 class="section-title">Discovered Related Literature ({{ candidates | length }} Papers)</h2>

        {% for item in candidates %}
        <div class="card">
            <div class="card-header">
                <div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                        <span class="badge">Rank #{{ item.candidate.rrf_rank or loop.index }}</span>
                        {% if item.paper.is_open_access %}
                        <span class="badge badge-success">Open Access PDF</span>
                        {% endif %}
                        {% if item.summary and item.summary.data_availability %}
                          {% if item.summary.data_availability == 'publicly_available' %}
                          <span class="badge badge-public">🌐 Publicly Available Data</span>
                          {% elif item.summary.data_availability == 'restricted' %}
                          <span class="badge badge-restricted">🔒 Restricted Access Data</span>
                          {% elif item.summary.data_availability == 'not_available' %}
                          <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #fca5a5; border-color: rgba(239, 68, 68, 0.3);">🚫 Data Not Available</span>
                          {% elif item.summary.data_availability == 'not_reported' %}
                          <span class="badge" style="background: rgba(148, 163, 184, 0.15); color: #cbd5e1; border-color: rgba(148, 163, 184, 0.3);">❓ Data Availability Not Reported</span>
                          {% elif item.summary.data_availability == 'mixed' %}
                          <span class="badge" style="background: rgba(168, 85, 247, 0.15); color: #e9d5ff; border-color: rgba(168, 85, 247, 0.3);">🔀 Mixed Data Availability</span>
                          {% else %}
                          <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #fcd34d; border-color: rgba(245, 158, 11, 0.3);">⚠️ Data Availability Unclear</span>
                          {% endif %}
                        {% endif %}
                    </div>
                    <div class="paper-title">{{ item.paper.title }}</div>
                    <div class="paper-authors">
                        {{ item.paper.authors | join(', ') }} ({{ item.paper.publication_year or 'N/A' }}) — <em>{{ item.paper.venue or 'Academic Venue' }}</em>
                    </div>
                </div>
            </div>

            {% if item.summary %}
            <div class="summary-box">
                <div class="summary-field">
                    <label>Problem Formulation</label>
                    <div>{{ item.summary.problem_formulation }}</div>
                </div>
                <div class="summary-field">
                    <label>Methodological Novelty</label>
                    <div>{{ item.summary.methodological_novelty }}</div>
                </div>
                <div class="summary-field">
                    <label>Empirical Findings</label>
                    <div>{{ item.summary.empirical_findings }}</div>
                </div>
                <div class="summary-field">
                    <label>Data Availability & Evidence</label>
                    <div>
                        {% if item.summary.data_availability == 'publicly_available' %}
                        <span style="color: #6ee7b7; font-weight: 600;">Publicly Available</span>
                        {% elif item.summary.data_availability == 'restricted' %}
                        <span style="color: #fcd34d; font-weight: 600;">Restricted Access</span> (Application / Approval Required)
                        {% elif item.summary.data_availability == 'not_available' %}
                        <span style="color: #fca5a5; font-weight: 600;">Not Available</span> (Cannot be shared / Private)
                        {% elif item.summary.data_availability == 'not_reported' %}
                        <span style="color: #cbd5e1; font-weight: 600;">Not Reported</span> (No availability statement in paper)
                        {% elif item.summary.data_availability == 'mixed' %}
                        <span style="color: #e9d5ff; font-weight: 600;">Mixed Access</span> (Multiple datasets with different statuses)
                        {% else %}
                        <span style="color: #fcd34d; font-weight: 600;">Unclear</span> (Insufficient or conflicting evidence)
                        {% endif %}

                        {% if item.summary.data_location %}
                          — Location/Access: 
                          {% if item.summary.data_location.startswith('http') %}
                          <a href="{{ item.summary.data_location }}" target="_blank" style="color: #60a5fa;">{{ item.summary.data_location }}</a>
                          {% else %}
                          <code style="color: #a7f3d0;">{{ item.summary.data_location }}</code>
                          {% endif %}
                        {% endif %}

                        {% if item.summary.data_availability_assessment and item.summary.data_availability_assessment.datasets %}
                        <div style="margin-top: 0.75rem; font-size: 0.85rem; background: rgba(0, 0, 0, 0.2); padding: 0.75rem; border-radius: 6px;">
                          <strong>Datasets Identified:</strong>
                          <ul style="margin-left: 1.25rem; margin-top: 0.25rem;">
                            {% for d in item.summary.data_availability_assessment.datasets %}
                            <li>
                              <strong>{{ d.dataset_name or 'Dataset' }}</strong> (<em>{{ d.role }}</em>):
                              <span style="font-weight: 600;">{{ d.status }}</span>
                              {% if d.repository %} | Repo: {{ d.repository }}{% endif %}
                              {% if d.accession %} | Accession: <code>{{ d.accession }}</code>{% endif %}
                              {% if d.access_conditions %} | Conditions: <em>{{ d.access_conditions }}</em>{% endif %}
                            </li>
                            {% endfor %}
                          </ul>
                        </div>
                        {% endif %}
                    </div>
                </div>
                <div class="summary-field">
                    <label>Technical Synthesis</label>
                    <p class="paragraph-summary">{{ item.summary.paragraph_summary }}</p>
                </div>
                {% if item.summary.relationship_to_target %}
                <div class="summary-field" style="margin-bottom: 0;">
                    <label>Relationship to Target Paper</label>
                    <div>{{ item.summary.relationship_to_target }}</div>
                </div>
                {% endif %}
            </div>
            {% else %}
            <p style="color: var(--text-muted); font-size: 0.9rem; font-style: italic; margin: 1rem 0;">Abstract-only overview available. LLM technical summary pending.</p>
            <p class="paragraph-summary" style="margin: 0.5rem 0;">{{ item.paper.abstract or 'No abstract text available.' }}</p>
            {% endif %}

            <div class="actions">
                {% if item.paper.oa_pdf_url %}
                <a href="{{ item.paper.oa_pdf_url }}" target="_blank" class="btn btn-primary">📄 View PDF</a>
                {% endif %}
                {% if item.paper.doi %}
                <a href="https://doi.org/{{ item.paper.doi }}" target="_blank" class="btn">🔗 DOI Link</a>
                {% endif %}
            </div>

            {% if item.bibtex %}
            <pre class="bibtex">{{ item.bibtex }}</pre>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</body>
</html>
